FROM pytorch/pytorch:2.5.1-cuda12.4-cudnn9-runtime

ARG MODEL_REPO=deepseek-ai/DeepSeek-V2-Lite
ARG MODEL_REVISION=main

RUN python -m pip install --no-cache-dir \
      "typing_extensions>=4.15" \
      "transformers==4.44.2" \
      "bitsandbytes>=0.45" \
      "lm-eval[hf,ruler]" \
    && sed -i \
      "s|http://curtis.ml.cmu.edu/datasets/hotpot/hotpot_dev_distractor_v1.json|https://huggingface.co/datasets/namlh2004/hotpotqa/resolve/main/hotpot_dev_distractor_v1.json?download=true|" \
      /opt/conda/lib/python3.11/site-packages/lm_eval/tasks/ruler/qa_utils.py

RUN mkdir -p /opt/models/DeepSeek-V2-Lite \
    && python -c "from huggingface_hub import snapshot_download; snapshot_download('${MODEL_REPO}', revision='${MODEL_REVISION}', local_dir='/opt/models/DeepSeek-V2-Lite', allow_patterns=['*.json', '*.py', 'LICENSE'])"

# Keep each weight shard in a separate image layer so registry uploads stay
# below the per-layer size limit.
RUN python -c "from huggingface_hub import hf_hub_download; hf_hub_download('${MODEL_REPO}', 'model-00001-of-000004.safetensors', revision='${MODEL_REVISION}', local_dir='/opt/models/DeepSeek-V2-Lite')"
RUN python -c "from huggingface_hub import hf_hub_download; hf_hub_download('${MODEL_REPO}', 'model-00002-of-000004.safetensors', revision='${MODEL_REVISION}', local_dir='/opt/models/DeepSeek-V2-Lite')"
RUN python -c "from huggingface_hub import hf_hub_download; hf_hub_download('${MODEL_REPO}', 'model-00003-of-000004.safetensors', revision='${MODEL_REVISION}', local_dir='/opt/models/DeepSeek-V2-Lite')"
RUN python -c "from huggingface_hub import hf_hub_download; hf_hub_download('${MODEL_REPO}', 'model-00004-of-000004.safetensors', revision='${MODEL_REVISION}', local_dir='/opt/models/DeepSeek-V2-Lite')" \
    && rm -rf /opt/models/DeepSeek-V2-Lite/.cache /root/.cache

COPY exp/mla_benchmarking.py /opt/santapp/exp/mla_benchmarking.py

ENV BENCHMARK_ROOT=/runtime \
    HF_HUB_OFFLINE=1 \
    TRANSFORMERS_OFFLINE=1 \
    HF_HUB_ENABLE_HF_TRANSFER=0

WORKDIR /opt/santapp
