FROM ghcr.io/stayfish/santapp-benchmark:deepseek-v2-lite-v1

RUN python -m pip install --no-cache-dir --no-deps --force-reinstall \
      "transformers==4.41.2" \
      "accelerate==0.29.3" \
      "bitsandbytes==0.43.1" \
      "tokenizers==0.19.1"

RUN mkdir -p /opt/compat/flash_attn \
    && touch /opt/compat/flash_attn/__init__.py

COPY exp/deepseek_diagnostic.py /opt/santapp/exp/deepseek_diagnostic.py

ENV PYTHONPATH=/opt/compat
